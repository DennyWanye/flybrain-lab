{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "graph_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "weight_direction": {
      "const": "W[post,pre]"
    },
    "interpretation": {
      "const": "structural_connections_not_causality"
    },
    "neighborhoods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "center_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
          },
          "node_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
            },
            "minItems": 1,
            "maxItems": 129
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
                },
                "target_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
                },
                "signed_weight": {
                  "type": "number"
                }
              },
              "required": [
                "source_id",
                "target_id",
                "signed_weight"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 512
          },
          "total_incoming_edges": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "total_outgoing_edges": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "center_id",
          "node_ids",
          "edges",
          "total_incoming_edges",
          "total_outgoing_edges",
          "truncated"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "graph_sha256",
    "weight_direction",
    "interpretation",
    "neighborhoods"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded structural neighborhoods"
}
