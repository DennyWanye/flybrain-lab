{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "graph_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mapping_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "neuron_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "neuron_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
          },
          "dataset_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "roles": {
            "type": "array",
            "items": {
              "enum": [
                "engineered_input",
                "engineered_readout",
                "background"
              ]
            },
            "minItems": 1,
            "maxItems": 3
          },
          "cell_type": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "region_labels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "minItems": 0,
            "maxItems": 16
          },
          "metadata_source": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "position": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "xyz": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "unit": {
                    "enum": [
                      "um",
                      "nm",
                      "voxel"
                    ]
                  },
                  "coordinate_space": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "source_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "xyz",
                  "unit",
                  "coordinate_space",
                  "source_sha256"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "dynamic_recorded": {
            "type": "boolean"
          }
        },
        "required": [
          "neuron_index",
          "neuron_id",
          "dataset_id",
          "roles",
          "cell_type",
          "region_labels",
          "metadata_source",
          "position",
          "dynamic_recorded"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "graph_sha256",
    "mapping_sha256",
    "nodes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recorded and local-neighborhood neuron catalog"
}
