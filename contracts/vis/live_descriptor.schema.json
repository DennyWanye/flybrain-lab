{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable live-source descriptor 1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "view_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "source_epoch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "graph_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mapping_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "p1_config_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_code_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "node_count": {
      "type": "integer",
      "minimum": 1
    },
    "edge_count": {
      "type": "integer",
      "minimum": 0
    },
    "environment_id": {
      "const": "FlyToTarget2D-v1"
    },
    "world_axes": {
      "const": "+X forward; +Y left; +Z up"
    },
    "fixed_height_m": {
      "const": 1.0
    },
    "fixed_yaw_rad": {
      "const": 0.0
    },
    "connectome_trainable": {
      "const": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "live_readout": {
          "type": "boolean"
        },
        "substep_spikes": {
          "type": "boolean"
        },
        "physics_path": {
          "type": "boolean"
        },
        "topology": {
          "type": "boolean"
        },
        "anatomy": {
          "type": "boolean"
        }
      },
      "required": [
        "live_readout",
        "substep_spikes",
        "physics_path",
        "topology",
        "anatomy"
      ],
      "additionalProperties": false
    },
    "recorded_neuron_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "descriptor_kind": {
      "const": "live"
    },
    "source_kind": {
      "const": "simulation_live"
    },
    "p1_mode": {
      "enum": [
        "brain",
        "direct",
        "reference",
        "random"
      ]
    },
    "files": {
      "type": "object",
      "properties": {
        "latest": {
          "const": "live.latest.json"
        },
        "metrics": {
          "const": "live.metrics.json"
        },
        "status": {
          "const": "live.status.json"
        },
        "catalog": {
          "const": "neurons.json"
        }
      },
      "required": [
        "latest",
        "metrics",
        "status",
        "catalog"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "view_id",
    "run_id",
    "source_epoch",
    "dataset_id",
    "graph_sha256",
    "mapping_sha256",
    "p1_config_sha256",
    "source_code_sha256",
    "node_count",
    "edge_count",
    "environment_id",
    "world_axes",
    "fixed_height_m",
    "fixed_yaw_rad",
    "connectome_trainable",
    "capabilities",
    "recorded_neuron_ids",
    "descriptor_kind",
    "source_kind",
    "p1_mode",
    "files"
  ],
  "additionalProperties": false
}
